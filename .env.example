# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# DigitalOcean Personal Access Token with genai (create, read, update)
# and project (read) scopes.
DIGITALOCEAN_API_TOKEN=dop_v1_your_token_here

# UUID of the agent under test. Get it from: doctl gradient agent list
AGENT_UUID=your_agent_uuid_here

# UUID of the evaluation test case bound to the agent.
TEST_CASE_UUID=your_test_case_uuid_here

# Pass mark for the star metric, as a percentage (no % sign).
# Also set in config/agent.yaml, which the sync pushes to the platform.
STAR_THRESHOLD=80